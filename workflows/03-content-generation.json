{
  "name": "03 每周内容生成(待审核)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 10 * * 1,3,5" }] }
      },
      "id": "c1",
      "name": "每周一三五 10 点",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// 内容主题轮换: 按星期几取不同主题。按需改成你的行业话题。\nconst topics = [\n  '客户痛点与常见误区',\n  '真实客户案例与结果',\n  '行业趋势与采购决策要点',\n];\nconst idx = new Date().getDay() % topics.length;\nreturn [{ json: { topic: topics[idx] } }];"
      },
      "id": "c2",
      "name": "选择主题",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 800, messages: [{ role: 'user', content: '你是 B2B 营销文案专家。业务介绍:' + $env.PRODUCT_PITCH + '\\n请围绕主题「' + $json.topic + '」写一条适合 LinkedIn/公众号的短帖(150-250 字):开头一句抓人的观点,中间给一个具体例子,结尾引导私信或留言咨询。不要夸大、不要编造数据。' }] }) }}",
        "options": {}
      },
      "id": "c3",
      "name": "Claude 生成文案",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $env.SLACK_CONTENT_CHANNEL }}"
        },
        "text": "=📝 待审核内容({{ $('选择主题').item.json.topic }})\n\n{{ $json.content[0].text }}\n\n确认无误后,手动在 Metricool 排期发布。",
        "otherOptions": {}
      },
      "id": "c4",
      "name": "Slack 发送待审核",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [720, 0]
    }
  ],
  "connections": {
    "每周一三五 10 点": { "main": [[{ "node": "选择主题", "type": "main", "index": 0 }]] },
    "选择主题": { "main": [[{ "node": "Claude 生成文案", "type": "main", "index": 0 }]] },
    "Claude 生成文案": { "main": [[{ "node": "Slack 发送待审核", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
