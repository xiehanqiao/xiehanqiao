# 复制为 .env 后填写。.env 已被 .gitignore 忽略,切勿提交。

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# 用 `openssl rand -hex 24` 生成;丢失后已保存的凭据将无法解密
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=Asia/Shanghai

# 内容生成用
ANTHROPIC_API_KEY=

# Notion 线索库的 database id
NOTION_LEADS_DB_ID=

# Slack 频道名(不带 #)
SLACK_LEADS_CHANNEL=leads
SLACK_CONTENT_CHANNEL=content-review

# 业务信息(用于生成开发信和内容)
PRODUCT_PITCH=一句话介绍你的产品/服务与核心价值
SENDER_NAME=你的名字
